# 6. Counting Nodes

To count nodes, start with `count = 0`.

Every time we visit a node:

```python
count += 1
```

### Code

```python
def count_nodes(self):
    count = 0
    current = self.head

    while current is not None:
        count += 1
        current = current.next

    return count
```

Example:

```text
10 → 20 → 30 → 40 → None
```

Number of nodes:

```text
4
```

---

# 7. Complete Example

```python
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    def display(self):
        current = self.head

        while current is not None:
            print(current.data, end=" ")
            current = current.next

        print()

    def search(self, value):
        current = self.head

        while current is not None:
            if current.data == value:
                return True

            current = current.next

        return False

    def count_nodes(self):
        count = 0
        current = self.head

        while current is not None:
            count += 1
            current = current.next

        return count


ll = LinkedList()

ll.head = Node(10)
ll.head.next = Node(20)
ll.head.next.next = Node(30)
ll.head.next.next.next = Node(40)

ll.display()

print("20 found:", ll.search(20))
print("50 found:", ll.search(50))

print("Number of nodes:", ll.count_nodes())
```

### Output

```text
10 20 30 40
20 found: True
50 found: False
Number of nodes: 4
```

